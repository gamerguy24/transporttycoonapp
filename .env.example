# Copy to .env and edit. Node loads it automatically.
# .env is gitignored — keep real keys there, not in this file.

PORT=3000

# Unlocks the engine diagnostics (data source, API charge balance, manual tick) in
# Settings. Leave empty for local development and those are visible from localhost
# only — so a hosted deployment hides them by default. SET THIS when you deploy if
# you want to reach them from a browser.
ADMIN_KEY=

# mock   = synthetic Transport Tycoon economy (no credentials needed)
# tycoon = poll the live game API
DATA_SOURCE=mock

# How often the engine re-prices every coin (ms).
TICK_MS=30000

# --- live API settings (only used when DATA_SOURCE=tycoon) -------------------
# Paths sit at the root of this host: /alive, /charges.json, /economy.csv,
# /players.json, /top10/<stat>.
TYCOON_API_URL=https://api.tycoon.community
TYCOON_API_KEY=
TYCOON_TIMEOUT_MS=15000

# economy.csv is free, but it is a 3 MB full-history download with no gzip and no
# range support, and it only gains a row every 15 minutes — so it gets its own
# slow timer and is cached in between. Lowering this only wastes bandwidth.
TYCOON_ECONOMY_POLL_MS=900000

# Sector leaderboards used to tell the coin types apart. Each poll costs ONE API
# charge, so exactly one stat is polled per interval, round-robin. A SHORTER list
# refreshes each stat sooner at the same daily burn rate — it is not cheaper.
# Leave TYCOON_STATS empty to run entirely on free endpoints forever.
# Others available: quarry_coop, quarry_solo, quarry_excavate, ems_deliveries,
# vehicles_crafted, ems_streak_record, drops_collected, toll_paid, trap_paid.
TYCOON_STATS=quarry_deliver,drops_collected,toll_paid,houses_crafted
TYCOON_STAT_POLL_MS=900000
# Buy a baseline for every stat at startup so sector coins differentiate quickly.
# Baselines are persisted, so this is normally a one-off cost. Set false on a host
# with no persistent disk (e.g. Render free), where it would otherwise be re-spent
# on every restart.
TYCOON_PRIME_STATS=true
# Stop spending charges once this many remain. Refill in game: /api private refill
TYCOON_CHARGE_FLOOR=100

# --- real player accounts ---------------------------------------------------
# Players sign in as their real character and their in-game net worth becomes their
# buying power. The API is read-only, so trades never move real money.

# Tolerance on the "type your wallet balance" ownership check (or 2%, whichever is
# larger) — a player's wallet moves while they read the number off their screen.
IDENTITY_BALANCE_TOLERANCE=25000

# How often a linked player's real balance is re-read. Each read costs 1 charge.
IDENTITY_WEALTH_TTL_MS=60000

# Let ?id=<vrpId> in the URL claim a session with no balance challenge. Enable ONLY
# if your F1 menu fills that id in server-side — if a player can edit the URL by
# hand, this lets them claim anyone's account.
IDENTITY_TRUST_URL_ID=false

# --- tuning -----------------------------------------------------------------
# How long a purchase request waits for the issuer before it expires and the
# buyer's reserved funds are released (ms).
REQUEST_TTL_MS=900000
# Length of a "staking day". Drop to 60000 to demo 30-day stakes in half an hour.
STAKE_DAY_MS=86400000

# Where the exchange state is persisted.
DATA_FILE=data/store.json
